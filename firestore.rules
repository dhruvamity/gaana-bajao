rules_version = '2';

// Gaana-Bajao Firestore security rules.
//
// Model: tracks and playlists form a shared catalogue that any signed-in user
// can browse, but only the owner can modify. Everything that describes a
// person — profile, listening history, active devices — is private to that
// person and never readable by anyone else.
//
// Nothing is readable without authentication: the catalogue is user-uploaded
// music and must not be dumpable by anyone who reads the project id out of the
// client bundle.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Owner field must be present, must be the caller, and must never change.
    function ownsNew() {
      return isSignedIn() && request.resource.data.ownerId == uid();
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.ownerId == uid();
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // ---------------------------------------------------------------- tracks
    // Shared catalogue. Any signed-in user may read; only the uploader writes.
    match /tracks/{trackId} {
      function validTrack(data) {
        return data.title is string
            && data.title.size() > 0
            && data.title.size() <= 300
            && data.artist is string
            && data.artist.size() <= 300
            && data.audioUrl is string
            && data.audioUrl.matches('https://.*')
            && data.ownerId is string;
      }

      allow read: if isSignedIn();
      allow create: if ownsNew() && validTrack(request.resource.data);
      allow update: if ownsExisting()
                    && ownerUnchanged()
                    && validTrack(request.resource.data);
      allow delete: if ownsExisting();
    }

    // ------------------------------------------------------------- playlists
    // Shared for reading. The owner may do anything; listed collaborators may
    // edit contents but cannot transfer ownership or change the collaborator
    // set, and cannot delete the playlist.
    match /playlists/{playlistId} {
      function isCollaborator() {
        return isSignedIn()
            && resource.data.collaboratorIds is list
            && uid() in resource.data.collaboratorIds;
      }

      function collaboratorsUnchanged() {
        return request.resource.data.collaboratorIds == resource.data.collaboratorIds;
      }

      function validPlaylist(data) {
        return data.title is string
            && data.title.size() > 0
            && data.title.size() <= 200
            && data.trackIds is list
            && data.trackIds.size() <= 5000
            && data.ownerId is string;
      }

      allow read: if isSignedIn();
      allow create: if ownsNew() && validPlaylist(request.resource.data);
      allow update: if validPlaylist(request.resource.data)
                    && ownerUnchanged()
                    && (
                         ownsExisting()
                         || (isCollaborator() && collaboratorsUnchanged())
                       );
      allow delete: if ownsExisting();
    }

    // ----------------------------------------------------------------- users
    // Strictly private. Previously the whole collection was fetched into the
    // browser to populate a collaborator picker, exposing every user's email
    // and listening history to every other user.
    match /users/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;

      // Active playback devices, private to their owner.
      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
    }

    // -------------------------------------------------------- publicProfiles
    // The only thing one user may learn about another: display name and
    // avatar. This exists so the collaborator picker never needs to read
    // /users, and the write rule pins the shape so a client cannot smuggle an
    // email or a taste vector into a world-readable document.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && uid() == userId
                   && request.resource.data.keys().hasOnly(['name', 'avatar'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 120
                   && request.resource.data.avatar is string
                   && request.resource.data.avatar.size() <= 2048;
    }

    // ------------------------------------------------------------- telemetry
    // Append-only, and each user can only see their own events.
    match /telemetry/{eventId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ------------------------------------------------------- device_sessions
    // Connect & Handoff. This is a single top-level collection keyed by a
    // random device id, so the ONLY thing separating one person's devices from
    // another's is the userId field — which is why it is required on write and
    // matched on read. Clients must query it as
    // `where('userId','==',uid)`; an unfiltered listen is refused, because
    // rules are evaluated against the query rather than the rows it returns.
    //
    // Documents are disposable playback state, so a client may replace its own
    // device record wholesale, but never write one under someone else's id.
    match /device_sessions/{deviceId} {
      function validSession(data) {
        return data.userId is string
            && data.userId.size() > 0
            && data.name is string
            && data.name.size() <= 200
            && data.progressSeconds is number
            && data.volume is number
            && data.lastUpdated is number;
      }

      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && validSession(request.resource.data);
      allow update: if isSignedIn()
                    && resource.data.userId == uid()
                    && request.resource.data.userId == uid()
                    && validSession(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
